<?xml version="1.0" encoding="utf-8"?>
<!--
  API 30 and below. android:allowBackup="false" already switches Auto Backup
  off there; this file exists so the manifest reference resolves and so the
  intent is stated in both places rather than only in the newer one.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
